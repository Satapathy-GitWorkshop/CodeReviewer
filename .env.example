# ============================================================
# Code Review Dashboard - Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit .env to version control
# ============================================================

# GitHub Personal Access Token
# Create at: https://github.com/settings/tokens
# Required scopes: repo (read), public_repo
GITHUB_TOKEN=ghp_your_token_here

# Groq API Key (free tier available)
# Get at: https://console.groq.com
GROQ_API_KEY=gsk_your_key_here

# Database (for Docker/production - H2 is used by default in dev)
DB_USERNAME=crduser
DB_PASSWORD=changeme_strong_password
DATABASE_URL=jdbc:postgresql://localhost:5432/codereview

# Frontend API URL (set this when deploying frontend separately)
REACT_APP_API_URL=http://localhost:8080/api
